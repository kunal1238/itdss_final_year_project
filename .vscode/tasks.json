{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build Frontend (Production)",
      "type": "shell",
      "command": "npm --prefix frontend run build",
      "problemMatcher": [],
      "group": "build"
    },
    {
      "label": "Start Backend (FastAPI on Port 8000)",
      "type": "shell",
      "command": "python -m uvicorn main:app --app-dir backend --host 127.0.0.1 --port 8000",
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "new",
        "group": "servers"
      }
    },
    {
      "label": "Start Frontend (Vite Dev Server)",
      "type": "shell",
      "command": "npm --prefix frontend run dev",
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "new",
        "group": "servers"
      }
    },
    {
      "label": "Run Tests",
      "type": "shell",
      "command": "python -m unittest",
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "problemMatcher": [],
      "group": "test"
    }
  ]
}